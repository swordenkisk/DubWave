# .env.example
# Copy this file to .env and add your own credentials.
# Never commit .env or API keys.

# Audio transcription and text-to-speech API.
AUDIO_API_BASE=https://api.openai.com/v1
AUDIO_API_KEY=

# Chat-completions-compatible text API.
# OpenRouter can be used here for translation; audio endpoints are configured separately.
TEXT_API_BASE=https://api.openai.com/v1
TEXT_API_KEY=

# Select models available to the API provider you configured.
TRANSCRIPTION_MODEL=whisper-1
TRANSLATION_MODEL=gpt-4o-mini
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# Audio processing settings.
CHUNK_SECONDS=300
BACKGROUND_VOLUME=0.12